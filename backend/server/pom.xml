<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.runisys.ontodata</groupId>
        <artifactId>portal</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>portal-server</artifactId>
    <name>portal-server</name>
    <description>启动与装配模块：聚合各模块为可运行服务（端口 18085）</description>

    <dependencies>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-task-center</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-approval-center</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-result-center</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-requirement-center</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-operations-center</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-aggregation-center</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-personal-center</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-retention-center</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- WP-07：用 contracts 仓库的载荷 Schema 校验实际产生的事件（与 data-platform 同版本） -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.0.88</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
