<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.runisys.ontodata</groupId>
        <artifactId>portal</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>portal-server</artifactId>
    <name>portal-server</name>
    <description>启动与装配模块：聚合各模块为可运行服务（端口 18085）</description>

    <dependencies>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-task-center</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-approval-center</artifactId>
        </dependency>
        <dependency>
            <groupId>com.runisys.ontodata</groupId>
            <artifactId>portal-result-center</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
